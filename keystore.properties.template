# Copy this file to "keystore.properties" (same folder) and fill in real values,
# OR add the same four keys to local.properties, OR export them as environment
# variables in CI. keystore.properties / local.properties are git-ignored and
# MUST NOT be committed.
#
# Generate the keystore once (RSA 2048, ~27 years validity) with:
#   keytool -genkeypair -v -keystore codeeditor-release.jks \
#     -alias codeeditor -keyalg RSA -keysize 2048 -validity 10000 \
#     -storetype PKCS12
#
# Keep codeeditor-release.jks AND these passwords backed up forever: losing them
# means you can no longer publish updates to the same app on Google Play.
#
# storeFile is resolved relative to the project root (or can be an absolute path).
storeFile=codeeditor-release.jks
storePassword=CHANGE_ME
keyAlias=codeeditor
keyPassword=CHANGE_ME

# CI environment variable equivalents:
#   CODEEDITOR_STORE_FILE, CODEEDITOR_STORE_PASSWORD,
#   CODEEDITOR_KEY_ALIAS, CODEEDITOR_KEY_PASSWORD
